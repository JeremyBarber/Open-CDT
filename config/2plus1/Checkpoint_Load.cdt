Simulation:
  Name: Checkpoint_Load
  Workflow: CanonicalEnsemble
  Replicas: 8
  SpacelikeDimensions: 2

Seed:
  K: 0
  Timeslices: 32
  Rng: 99
  StartFrom: results/Checkpoint_Save/<timestamp>/ensemble.cdtbin

Physics:
  K0: 5.05
  Kd: 1.374610
  Delta: 0.69
  Epsilon: 0.0005
  TargetVolume: 16000

Thermalization:
  BurnInSweeps: 1000
  WindowSweeps: 1000

Sampling:
  SamplesPerReplica: 2
  MinDecorrelationSweeps: 200
  HausdorffSamples: 5
  HausdorffMaxRadius: 15
  SpectralSamples: 5
  SpectralMaxSigma: 50

Output:
  Directory: results